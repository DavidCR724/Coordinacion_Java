<?xml version="1.0" encoding="UTF-8"?>
<!--
  Descriptor del EAR. Declara los dos módulos de forma explícita para que Payara no tenga
  que adivinarlos: sin este archivo, al desplegar por carpetas (NetBeans, dist/gfdeploy)
  tomó CoordinadITO-ejb como librería y no como módulo EJB, y entonces el WAR no podía
  cargar sus beans (modelo.bean.* no existía para él).
-->
<application xmlns="https://jakarta.ee/xml/ns/jakartaee"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/application_11.xsd"
             version="11">
    <display-name>CoordinadITO</display-name>
    <module>
        <ejb>CoordinadITO-ejb.jar</ejb>
    </module>
    <module>
        <web>
            <web-uri>CoordinadITO-war.war</web-uri>
            <context-root>/CoordinadITO-war</context-root>
        </web>
    </module>
</application>

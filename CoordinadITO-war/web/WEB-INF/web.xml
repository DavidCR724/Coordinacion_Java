<?xml version="1.0" encoding="UTF-8"?>
<!--
  DESCRIPTOR DEL MÓDULO WEB (versión 4.0, la que pidió el profesor).
  Aquí se le dice al servidor: "las páginas .xhtml las atiende Faces".
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">

    <!-- Development muestra errores detallados en pantalla; en producción cambiar a Production. -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <!-- Los comentarios XML de los .xhtml no se envían al navegador. -->
    <context-param>
        <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- ============ PrimeFaces ============ -->
    <!-- Tema propio: Saga recoloreado con la paleta del ITO.
         Vive en resources/primefaces-coordinadito/theme.css (lo genera herramientas/generar-tema.py). -->
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>coordinadito</param-value>
    </context-param>
    <!-- Los scripts de PrimeFaces van al final del <body>: la página se pinta antes. -->
    <context-param>
        <param-name>primefaces.MOVE_SCRIPTS_TO_BOTTOM</param-name>
        <param-value>true</param-value>
    </context-param>

    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <!-- Solo cookie: evita que las URL lleven ";jsessionid=..." en la primera visita. -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Páginas propias para errores (plantilla-simple). -->
    <error-page>
        <error-code>403</error-code>
        <location>/vista/acceso-denegado.xhtml</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/vista/error.xhtml</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/vista/error.xhtml</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>
</web-app>
